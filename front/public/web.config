<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config — dossier /alcours/ (front). Calqué sur celui de svm, qui tourne sur le même
  serveur mutualisé OVH : la première version utilisait le module IIS URL Rewrite, absent sur
  ce serveur (erreur 500 sur TOUTE ressource, y compris les fichiers statiques). Le fallback
  SPA passe donc par <httpErrors> + ExecuteURL, qui ne dépend d'aucun module externe.
-->
<configuration>
  <system.webServer>
    <!-- Désactive les handlers WebDev/PC SOFT déclarés globalement sur ce serveur mutualisé,
         qui peuvent entrer en conflit avec un site Vue (noms exacts non vérifiables à distance :
         <remove> sur un handler absent ne fait rien, donc sans risque de les lister au cas où). -->
    <handlers>
      <remove name="WB_.awp" />
      <remove name="WB_/alcours" />
      <remove name="WB_/al-cours" />
      <remove name="AWP" />
      <remove name="PCSOFT_AWP" />
      <remove name="WebDev31" />
      <remove name="WebDev32" />
    </handlers>

    <directoryBrowse enabled="false" />

    <!-- Fallback SPA : toute URL introuvable (404) renvoie index.html pour laisser Vue Router
         prendre le relais côté client (ex. rechargement direct de /alcours/formations/123). -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/alcours/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
