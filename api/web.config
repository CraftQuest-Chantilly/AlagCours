<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config — dossier /alcours/api/. Plus de règle de réécriture d'URL (module IIS URL
  Rewrite absent sur ce serveur mutualisé OVH, cf. front/public/web.config) : toutes les
  requêtes visent directement index.php?route=..., une ressource physique existante, donc
  aucune règle de routage n'est nécessaire ici — seulement le handler PHP et la protection
  des fichiers internes.
-->
<configuration>
  <system.webServer>
    <!-- Mêmes handlers WebDev/PC SOFT désactivés que côté front (cf. son web.config) + handler
         PHP explicite, nécessaire sur ce serveur pour ce dossier (constaté avec svm/api/). -->
    <handlers>
      <remove name="WB_.awp" />
      <remove name="WB_/alcours" />
      <remove name="WB_/al-cours" />
      <remove name="AWP" />
      <remove name="PCSOFT_AWP" />
      <remove name="WebDev31" />
      <remove name="WebDev32" />
      <add name="PHP via FastCGI" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File" />
    </handlers>

    <directoryBrowse enabled="false" />

    <!-- Sans ça, IIS remplace toute réponse non-200 (mes erreurs JSON 401/404/503...) par sa
         page générique "500 - Erreur interne au serveur" — masquant le vrai code et message,
         constaté en déploiement (ex. échec de connexion base renvoyé comme un 500 générique
         au lieu du 503 JSON explicite). PassThrough laisse passer le corps produit par PHP. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- config.local.php et les dossiers lib/ et routes/ ne sont jamais servis directement. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="routes" />
          <add segment="config.local.php" />
          <add segment="config.local.example.php" />
          <add segment="config.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
